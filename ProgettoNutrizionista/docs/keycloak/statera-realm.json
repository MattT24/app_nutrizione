{
  "realm": "statera",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,

  "loginTheme": "statera",

  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@statera.local",
    "fromDisplayName": "Statera",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },

  "accessTokenLifespan": 300,

  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,

  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "otpPolicyType": "totp",

  "roles": {
    "realm": [
      {
        "name": "NUTRIZIONISTA",
        "description": "Ruolo tenant/app: il nutrizionista opera solo sui dati propri."
      },
      {
        "name": "SUPER_ADMIN",
        "description": "Ruolo control-plane: /api/admin/**, senza permessi app granulari."
      }
    ]
  },

  "clients": [
    {
      "clientId": "statera-bff",
      "name": "Statera BFF (Backend-for-Frontend)",
      "description": "Client confidential del BFF Spring Boot. Authorization Code + PKCE (S256).",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:8080/*",
        "http://localhost:4200/login/oauth2/code/keycloak",
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:4200/*",
        "backchannel.logout.url": "http://localhost:8080/logout/connect/back-channel/keycloak",
        "backchannel.logout.session.required": "true"
      }
    },
    {
      "clientId": "statera-admin",
      "name": "Statera Admin (service-account — Admin API)",
      "description": "Client machine-to-machine per l'erasure cross-store art.17 (KeycloakAdminClient). client_credentials + realm-management:manage-users. Isolato dal BFF utente (least-privilege).",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-admin-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],

  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "useJwksUrl": "true",
        "syncMode": "IMPORT"
      }
    }
  ],

  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "nutritionista.test@statera.local",
      "email": "nutritionista.test@statera.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Nutrizionista",
      "lastName": "Test",
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ],
      "realmRoles": [
        "NUTRIZIONISTA"
      ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "superadmin@statera.app",
      "email": "superadmin@statera.app",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Super",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "SuperAdmin123!",
          "temporary": true
        }
      ],
      "requiredActions": [
        "UPDATE_PASSWORD"
      ],
      "realmRoles": [
        "SUPER_ADMIN"
      ]
    },
    {
      "username": "service-account-statera-admin",
      "enabled": true,
      "serviceAccountClientId": "statera-admin",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
