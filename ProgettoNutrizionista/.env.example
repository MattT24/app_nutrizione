# Configurazione segreti backend Statera — COPIARE in `.env` (gitignored) e valorizzare.
# In dev i ${VAR} di application.properties si risolvono da .env (spring-dotenv).
# In produzione usare variabili d'ambiente reali (non committare mai i valori).

# --- Database (dev: TiDB Cloud; prod: Clever Cloud managed MySQL) ---
# characterEncoding=UTF-8 forza la connessione a utf8mb4 (dati art. 9 accentati/emoji).
# ⚠️ In prod: DB e tabelle devono essere utf8mb4, e i parametri TLS vanno adattati al provider
#    (i sslMode qui sotto sono TiDB-flavored, da rivedere per Clever Cloud MySQL).
DB_URL=jdbc:mysql://<host>:4000/<database>?sslMode=VERIFY_IDENTITY&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# --- Mail (Gmail SMTP) ---
MAIL_USERNAME=<gmail-address>
MAIL_PASSWORD=<gmail-app-password>

# --- JWT ---
# ATTENZIONE (B1): generare un valore casuale forte (>= 256 bit) prima della produzione.
JWT_SECRET=<random-strong-secret>

# --- Account demo ---
# Hash BCrypt (cost 12+) di una chiave master casuale di almeno 24 caratteri.
# La chiave in chiaro va conservata esclusivamente nel password manager del super admin.
DEMO_MASTER_PASSWORD_HASH=<bcrypt-hash-della-chiave-master>

# --- Super Admin (control-plane) — OBBLIGATORIO in prod ---
# In prod SuperAdminProductionSecurityValidator FALLISCE l'avvio se questi mancano o l'hash non è BCrypt cost>=12.
# SuperAdminSeeder crea l'account super-admin da questi valori. La password NON è mai in chiaro: solo l'hash
# BCrypt (cost 12+), come DEMO_MASTER_PASSWORD_HASH. La chiave in chiaro va SOLO nel password manager.
SUPERADMIN_EMAIL=<super-admin-email>
SUPERADMIN_PASSWORD_HASH=<bcrypt-hash-cost12+>

# --- Keycloak / OIDC (attivo SOLO col profilo keycloak: SPRING_PROFILES_ACTIVE=dev,keycloak) ---
# In dev funzionano i default inline di application-keycloak.properties; qui per override espliciti / prod.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/statera
KEYCLOAK_CLIENT_SECRET=<secret-client-bff-statera>
# I10 — Admin API (erasure cross-store art.17): client service-account least-privilege (solo manage-users).
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=statera
KEYCLOAK_ADMIN_CLIENT_SECRET=<secret-client-statera-admin>
